# Copie ce fichier en .env et remplis les valeurs

# Token du compte Discord (onglet Reseau du navigateur -> requete @me -> header Authorization)
DISCORD_TOKEN=
# Mot de passe du compte (requis par l'API Discord pour changer le pseudo)
DISCORD_PASSWORD=

# Topic ntfy.sh pour recevoir les notifications - choisis un nom unique/random
# (n'importe qui connaissant le topic peut lire tes notifs)
NTFY_TOPIC=

# Optionnel : ton propre serveur ntfy si tu en heberges un
# NTFY_SERVER=https://ntfy.sh

# Intervalle entre deux tentatives par candidat : tirage aleatoire uniforme entre ces deux valeurs (secondes)
POLL_INTERVAL_MIN_SECONDS=60
POLL_INTERVAL_MAX_SECONDS=90

# Si true, continue a surveiller les autres candidats meme apres un succes
CONTINUE_AFTER_SUCCESS=false

# Label affiche dans les logs et le dashboard
ACCOUNT_LABEL=compte1
