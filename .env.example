# Copy this file to .env and fill in the values

# Discord account token (browser Network tab -> a request to @me -> Authorization header)
DISCORD_TOKEN=
# Account password (Discord requires it to change the username)
DISCORD_PASSWORD=

# ntfy.sh topic for notifications - pick a unique/random name
# (anyone who knows the topic can read your notifications)
NTFY_TOPIC=

# Optional: your own ntfy server if you self-host one
# NTFY_SERVER=https://ntfy.sh

# Delay between two attempts per candidate: random uniform draw between these two values (seconds)
POLL_INTERVAL_MIN_SECONDS=60
POLL_INTERVAL_MAX_SECONDS=90

# If true, keep watching the other candidates even after a success
CONTINUE_AFTER_SUCCESS=false

# Label shown in the logs and the dashboard
ACCOUNT_LABEL=account1
